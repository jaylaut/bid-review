# ─────────────────────────────────────────────────────────────
# review-engine 环境变量模板
# 用法：复制为 .env 后填写（.env 已在 .gitignore 里，不要提交）
#   cp review-engine/.env.example review-engine/.env
# ─────────────────────────────────────────────────────────────

# ═══ 运行环境 ═══════════════════════════════════════════════
APP_ENV=dev
LOG_LEVEL=INFO
# 全链路追踪 ID 前缀，便于在 Langfuse / Loki 里筛
SERVICE_NAME=review-engine

# ═══ 日志（src/common/logging.py，契约见 docs/12）════════════
# stdout 格式：dev 用 console（终端可读）；prod 用 json（Loki 直接解析字段）。
# 注意：文件日志恒为 JSON，不受此项影响——Alloy 采集的是文件，dev 也要能被检索。
LOG_FORMAT=console
# 容器部署可设 false（stdout 直接给采集器收）；本机开发必须 true，文件是采集源
LOG_FILE_ENABLED=true
LOG_DIR=logs
LOG_BACKUP_DAYS=14
# 单字段截断上限（字符）：防止标书原文、整段 prompt 灌进日志
LOG_MAX_TEXT_LEN=2000

# ═══ PostgreSQL ═════════════════════════════════════════════
# 注意：驱动必须是 asyncpg（同步驱动会阻塞事件循环）
PG_DSN=postgresql+asyncpg://bid:bid@localhost:5432/bid_review
PG_POOL_MIN=5
PG_POOL_MAX=40
# 40 ≈ LLM 并发 8 × 4 + 8，见 docs/07 §A7 坑 2

# ═══ Redis ══════════════════════════════════════════════════
REDIS_URL=redis://localhost:6379/0

# ═══ RocketMQ（5.x，走 gRPC proxy 协议）═══════════════════════
# proxy 的 gRPC 地址（不是 NameServer 的 9876，也不是 Broker 的 10911）
ROCKETMQ_ENDPOINT=localhost:8081
ROCKETMQ_TOPIC_INGEST=bid-ingest
ROCKETMQ_TOPIC_REVIEW=bid-review
ROCKETMQ_GROUP_REVIEW=bid-review-consumer
# 单次拉取条数（对应 RabbitMQ prefetch=2 的背压语义）
ROCKETMQ_RECEIVE_BATCH=2
# 消息不可见时长（秒），超时未确认自动重投
ROCKETMQ_INVISIBLE_S=60

# ═══ MinIO（离线管道读原件）══════════════════════════════════
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET_RAW=bid-raw
MINIO_SECURE=false

# ═══ 判定 LLM（云端，OpenAI 兼容接口）═══════════════════════
# 二选一填其一，另一组留空即可
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# 备选：通义千问（DeepSeek 429 时切）
# LLM_PROVIDER=qwen
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_API_KEY=
# LLM_MODEL=qwen-max

# ═══ 本地模型服务（Ollama）══════════════════════════════════
OLLAMA_ENDPOINT=http://localhost:11434

# 嵌入：必须 1024 维，与 DDL vector(1024) 严格一致
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_DIM=1024
# 查询侧指令（Qwen3 指令感知）；改动此值 = 新 embedding_ver = 全量重嵌入
EMBEDDING_QUERY_INSTRUCTION=Instruct: 检索投标技术方案中响应以下技术要求的段落
# ⚠️ 必须显式设置，否则长 chunk 被静默截断（无任何报错）
OLLAMA_NUM_CTX=1024

# 重排：靠 logprobs 还原 0-1 连续分数，不能走 chat 二值化
RERANK_MODEL=dengcao/Qwen3-Reranker-0.6B:Q8_0
RERANK_CANDIDATES=20
RERANK_TOP_N=5
RERANK_REFUSAL_THRESHOLD=0.15

# ═══ Agent 预算与护栏（docs/07 §A6）═════════════════════════
AGENT_MAX_STEPS=6
AGENT_MAX_TOKENS_PER_ITEM=12000
AGENT_MAX_COST_PER_ITEM_CNY=0.05
AGENT_MAX_SECONDS_PER_ITEM=120
# 并发：LLM 走云 API，重排走本地 CPU 单实例 —— 两个信号量必须分开
AGENT_LLM_CONCURRENCY=8
AGENT_RERANK_CONCURRENCY=2
# 工具调用格式：native（原生 tool_calls）| json（结构化输出兜底）
AGENT_TOOL_CALL_MODE=native

# ═══ 开关 ═══════════════════════════════════════════════════
# true = 判定也走本地 qwen3:14b（全内网演示形态，质量降级，trace 会标注）
LOCAL_LLM=false

# ═══ 观测 ═══════════════════════════════════════════════════
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ═══ 日志（src/common/logging.py）═══════════════════════════
LOG_LEVEL=INFO              # DEBUG 只在本地排障；生产 DEBUG 会打出检索中间量
LOG_FORMAT=console          # dev 用 console（彩色可读）；prod 用 json（Loki 直接解析）
LOG_FILE_ENABLED=true       # 容器部署建议 false（stdout 交给 promtail，省卷）
LOG_DIR=logs
LOG_BACKUP_DAYS=14
LOG_MAX_TEXT_LEN=2000       # 单字段截断上限，防止把标书原文灌进日志

