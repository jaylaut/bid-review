# ── Python ────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ── 虚拟环境 ──────────────────────────────────────────────
# review-engine/.venv 里有几千个文件，进库会让每次 git status 都变慢
.venv/
venv/
env/

# ── 凭据 ─────────────────────────────────────────────────
# 真实的 .env 里有 LLM_API_KEY、PG_DSN、MinIO 密码，只保留 .example 模板
.env
.env.*
!.env.example
!*.env.example

# ── IDE ──────────────────────────────────────────────────
.idea/
.vscode/
*.iml

# ── 运行产物 ──────────────────────────────────────────────
logs/
*.log

# ── 解析中间产物 ──────────────────────────────────────────
# MinerU 每份标书会写 markdown + 图片 + 版面 JSON，几个 GB 起。
# 实际位置是 data/_mineru（ParseConfig.mineru_work_dir 由 parsed_dir 的上一级派生）
data/_mineru/
data/parsed/_mineru/

# ── 系统文件 ──────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── 观测栈运行态 ─────────────────────────────────────────
# Loki 的 chunk/WAL 和 Alloy 的本地存储是运行时数据，会被自己轮转删除
data/loki/
data/alloy/
